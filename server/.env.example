# EtsyOps connector — server (Vercel) environment.
# Copy to .env.local for local dev, or set these in the Vercel project settings.
# No secrets are committed; fill these in locally / in the dashboard.

# --- Storage (Redis-shaped, backed by Supabase Postgres) ---
# The server talks to Supabase via PostgREST RPC (nb_get/nb_set/nb_lpush/...).
# Apply supabase/schema.sql to your project first, then set:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth ---
# Signs all JWTs (session / agent / mcp tokens). Generate with:  openssl rand -hex 32
# REQUIRED in production — the server refuses to boot with the dev default.
JWT_SECRET=change-me-to-a-long-random-string

# Canonical public base URL. Optional; recommended behind a reverse proxy that
# forwards a client-controlled Host/X-Forwarded-Host header. Vercel sets this
# correctly on its own, so it's usually unnecessary there.
# PUBLIC_BASE_URL=https://etsyops.vercel.app

# --- Etsy Open API v3 (the live-data credential) ---
# The registered Etsy app's keystring (x-api-key). Per-seller OAuth access tokens
# are stored per user (etsy:token:<userId>) once a seller connects their shop, and
# the shop id in etsy:shop:<userId>. If ETSY_KEYSTRING is unset OR the current user
# hasn't connected a shop, every tool returns an honest "connect your Etsy shop"
# error rather than inventing data. The reviewer demo account is served a built-in
# sample shop, so demo mode works with no ETSY_KEYSTRING at all.
# ETSY_KEYSTRING=your-etsy-app-keystring

# --- Reviewer demo account ---
# The demo account (served the sample shop, exempt from billing + email gates).
DEMO_EMAIL=reviewer@etsyops.demo
# DEMO_PASSWORD is set when you seed the account (POST /api/signup) — keep it in
# .env.local only; it is what reviewers enter on the OAuth consent page.
# DEMO_PASSWORD=

# --- Email verification (optional) ---
# If RESEND_API_KEY is unset, email verification is disabled and every account is
# treated as verified (fine for local dev / self-host without email).
# RESEND_API_KEY=re_...
# EMAIL_FROM=EtsyOps <noreply@yourdomain.com>
# Set to 1 to REQUIRE a verified email before an account can connect to ChatGPT.
# Off by default; the reviewer demo account and pre-existing accounts are exempt.
# REQUIRE_EMAIL_VERIFICATION=1

# --- Stripe billing (optional; paid-tier gating) ---
# If unset, billing is disabled and every account is treated as paid (self-host /
# demo). Use TEST-mode keys (sk_test_...) to build/verify; swap to live later.
# The current model is a single free/paid gate; the Seller/Growth/Agency tiers are
# presented on /upgrade over one recurring price (STRIPE_PRICE_PRO).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...

# --- OpenAI domain verification (set when submitting to the directory) ---
# The MCP section issues a token; serve it at /.well-known/openai-apps-challenge.
# OPENAI_APPS_CHALLENGE=the-public-token
